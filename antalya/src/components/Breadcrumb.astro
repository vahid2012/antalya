---
import { SITE } from '../data/site';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: `${SITE.url}${item.href}`,
  })),
};
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-4 pt-6 lg:px-8">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-neutral-500">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index < items.length - 1 ? (
          <a href={item.href} class="text-primary-600 transition-colors hover:text-primary-700">
            {item.name}
          </a>
        ) : (
          <span class="font-medium text-neutral-700">{item.name}</span>
        )}
        {index < items.length - 1 && (
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-neutral-400">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
