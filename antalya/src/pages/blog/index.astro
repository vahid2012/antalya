---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { SITE } from '../../data/site';
import { BLOG_POSTS } from '../../data/blog';

const title = 'Antalya Travel Blog | Guides, Tips & Hidden Gems | Tours Antalya';
const description = 'Read expert travel guides about Antalya, Turkey. Discover hidden gems, airport tips, hotel recommendations, and local insights for your next Mediterranean trip.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
  ],
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Tours Antalya Blog',
  url: `${SITE.url}/blog/`,
  blogPost: BLOG_POSTS.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `${SITE.url}/blog/${post.slug}/`,
    datePublished: post.date,
    author: { '@type': 'Organization', name: post.author },
  })),
};
---

<Layout title={title} description={description} schema={[breadcrumbSchema, blogSchema]} canonical="/blog/">
  <section class="bg-primary-950 py-16">
    <div class="mx-auto max-w-7xl px-4 lg:px-8">
      <span class="inline-block rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-primary-200 backdrop-blur-sm">
        Travel Blog
      </span>
      <h1 class="mt-6 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
        Antalya Travel Guides & Insights
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-primary-100">
        Expert guides, local tips, and hidden gem discoveries to help you plan the perfect
        Antalya experience, whether for business or leisure.
      </p>
    </div>
  </section>

  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog/' },
  ]} />

  <section class="mx-auto max-w-7xl px-4 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {BLOG_POSTS.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition-all hover:shadow-xl"
        >
          <div class="relative h-56 overflow-hidden">
            <img
              src={post.image}
              alt={post.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
              width="600"
              height="300"
            />
            <div class="absolute top-3 left-3 rounded-full bg-primary-900/80 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm">
              {post.category}
            </div>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <p class="text-xs text-neutral-400">{new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} &middot; {post.readTime}</p>
            <h2 class="mt-3 font-display text-xl font-bold text-neutral-900 group-hover:text-primary-600">
              {post.title}
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-neutral-600">{post.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-600">
              Read article
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:translate-x-1">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-primary-50 p-8 text-center">
      <h2 class="font-display text-2xl font-bold text-neutral-900">
        Need Help Planning Your Antalya Trip?
      </h2>
      <p class="mt-4 text-base text-neutral-600">
        Our local experts are available 24/7 on WhatsApp to answer your questions and help you
        book the perfect Antalya experience.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <WhatsAppCTA label="Ask Us Anything" />
      </div>
    </div>
  </section>
</Layout>
