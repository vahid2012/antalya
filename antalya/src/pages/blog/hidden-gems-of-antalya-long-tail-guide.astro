---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import { SITE } from '../../data/site';
import { BLOG_POSTS } from '../../data/blog';

const post = BLOG_POSTS[2];
const title = `${post.title} | Tours Antalya Blog`;
const description = post.description;
const heroImage = post.image;

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  datePublished: post.date,
  author: { '@type': 'Organization', name: post.author },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  url: `${SITE.url}/blog/${post.slug}/`,
  image: post.image,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.title, item: `${SITE.url}/blog/${post.slug}/` },
  ],
};

const otherPosts = BLOG_POSTS.filter((p) => p.slug !== post.slug);

const gems = [
  { name: 'Kaleiçi Boutique Hotels', region: 'Antalya Old Town', desc: 'Stay in a restored Ottoman mansion within the ancient city walls for an authentic and atmospheric experience.' },
  { name: 'Belek Golf & Spa Retreats', region: 'Belek', desc: 'Combine championship golf rounds with luxury spa treatments at all-inclusive golf resorts.' },
  { name: 'Lara All-Inclusive Resorts', region: 'Lara', desc: 'Beachfront mega-resorts with water parks, multiple restaurants, and nightlife access.' },
  { name: 'Konyaaltı Beach Guesthouses', region: 'Konyaaltı', desc: 'Small, locally-run guesthouses near the city\'s western beach, perfect for independent travelers.' },
  { name: 'Sorgun\'s Quiet Coastline', region: 'Side/Sorgun', desc: 'Pine-forested beaches with serene adult-friendly resorts far from the crowds.' },
  { name: 'Phaselis Ancient City', region: 'Kemer', desc: 'Ruins of an ancient Lycian city hidden within a national park, with three bays for swimming.' },
];
---

<Layout title={title} description={description} schema={[blogSchema, breadcrumbSchema]} canonical={`/blog/${post.slug}/`} type="article" image={heroImage}>
  <section class="relative flex min-h-[40vh] items-end overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt={post.title} class="h-full w-full object-cover" fetchpriority="high" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-t from-primary-950/95 via-primary-950/60 to-primary-950/30"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-4 py-16 lg:px-8">
      <span class="inline-block rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-primary-200 backdrop-blur-sm">
        {post.category}
      </span>
      <h1 class="mt-6 font-display text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
        {post.title}
      </h1>
      <p class="mt-4 text-base text-primary-200">
        {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} &middot; {post.readTime} &middot; By {post.author}
      </p>
    </div>
  </section>

  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog/' },
    { name: post.title, href: `/blog/${post.slug}/` },
  ]} />

  <div class="mx-auto max-w-4xl px-4 py-12 lg:px-8">
    <QuickFacts
      title="Key Takeaways"
      items={[
        { label: 'Focus', value: 'Boutique, niche, and off-the-beaten-path Antalya experiences' },
        { label: 'Keywords targeted', value: 'Kaleiçi boutique hotel, Belek golf hotel, Lara all-inclusive' },
        { label: 'Best for', value: 'Travelers seeking authentic, less crowded experiences' },
        { label: 'Hidden gems', value: 'Phaselis, Sorgun, Konyaaltı guesthouses, Kaleiçi mansions' },
        { label: 'Budget range', value: 'From affordable guesthouses to ultra-luxury resorts' },
        { label: 'Booking', value: 'All stays bookable via WhatsApp with local expert advice' },
      ]}
    />
  </div>

  <article class="mx-auto max-w-4xl px-4 pb-12 lg:px-8">
    <h2 class="font-display text-3xl font-bold text-neutral-900">Beyond the Brochure: Antalya\'s Hidden Gems</h2>
    <p class="mt-6 text-lg leading-relaxed text-neutral-700">
      While most visitors to Antalya flock to the massive all-inclusive resorts of Lara and Belek,
      the province holds countless hidden gems that offer more intimate, authentic, and
      memorable experiences. This long-tail travel guide uncovers the secret corners of Antalya
      that most tourists never see, from <strong>Kaleiçi boutique hotel booking Antalya</strong>
      options to secluded ancient ruins and quiet pine-forested beaches.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Kaleiçi Boutique Hotel Booking Antalya</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      The historic Kaleiçi district is home to dozens of boutique hotels housed in restored
      Ottoman mansions, each with its own character and charm. Unlike the massive resorts outside
      the city, these properties offer 10-30 rooms, personalized service, and an atmosphere steeped
      in history. Imagine waking up in a 200-year-old stone house, breakfasting on a rooftop
      terrace overlooking the harbor, and stepping out your door into a cobblestone street lined
      with ancient walls.
    </p>
    <p class="mt-4 text-base leading-relaxed text-neutral-700">
      Boutique hotels in Kaleiçi cater to travelers who value authenticity over amenities. While
      you won\'t find water slides or swim-up bars, you will find unique architectural details,
      handcrafted furnishings, and innkeepers who treat you like family. Many properties feature
      courtyard pools, traditional Turkish breakfasts, and rooftop bars with sunset views. Prices
      range from €50 to €200 per night depending on the season and room category. We can
      recommend and book the perfect Kaleiçi boutique hotel based on your preferences.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Belek Golf Hotel and Spa Packages</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      Belek is synonymous with golf, but there\'s more to the area than fairways and greens. A
      <strong>Belek golf hotel and spa package</strong> lets you combine world-class golf with
      luxury wellness in a setting of Mediterranean pine forests. The key is knowing which resorts
      offer the best golf-spa combinations and when to book for the best rates. The golf season in
      Belek runs from September to May, with peak conditions in October-November and March-April.
    </p>
    <p class="mt-4 text-base leading-relaxed text-neutral-700">
      Beyond the golf courses, Belek hides the ancient Roman ruins of Aspendos, with its
      magnificently preserved 2nd-century theater, and the Eurymedon Bridge, a Roman structure
      still standing after nearly 2,000 years. The Köprülü Canyon National Park, just inland from
      Belek, offers white-water rafting, hiking, and dramatic mountain scenery. Our team can
      arrange combined golf-and-adventure packages that show you a different side of Belek.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Lara All-Inclusive Resort with Nightclub Access</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      Lara Beach is famous for its mega-resorts, but the hidden gem here is the combination of
      all-inclusive luxury with direct access to Antalya\'s best nightlife. A <strong>Lara
      all-inclusive resort with nightclub access</strong> gives you the best of both worlds: days
      spent on the beach with unlimited food and drinks, and nights at Antalya\'s hottest clubs
      just minutes away. Resorts like Concorde De Luxe and Delphin Imperial are within a 10-minute
      drive of Gaga Club and other major nightlife venues.
    </p>
    <p class="mt-4 text-base leading-relaxed text-neutral-700">
      The secret to a great Lara experience is choosing the right resort for your style. Some
      properties are better for families with children, others for couples seeking romance, and
      others for groups looking to party. Our local expertise ensures you book the resort that
      matches your travel style, avoiding the disappointment of landing at a family resort when
      you wanted nightlife, or vice versa.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Konyaaltı Beach Guesthouse Antalya</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      On the opposite side of the city from Lara, Konyaaltı Beach offers a different vibe: pebbled
      shores, mountain views, and a more local atmosphere. While there are large hotels here too,
      the hidden gems are the small guesthouses and apart-hotels run by local families. A
      <strong>Konyaaltı beach guesthouse Antalya</strong> stay puts you within walking distance of
      the beach, the Antalya Aquarium, the Aqualand water park, and the cliff-top cafes with
      panoramic sea views, all at a fraction of the cost of the big resorts.
    </p>
    <p class="mt-4 text-base leading-relaxed text-neutral-700">
      Konyaaltı is also home to some of Antalya\'s best beach clubs, which transform from daytime
      lounging spots into sunset cocktail bars in the evening. The area has a more relaxed,
      bohemian feel compared to Lara\'s resort atmosphere, attracting independent travelers,
      digital nomads, and locals alike. The cliffside cafés between Konyaaltı and Kaleiçi offer
      some of the most spectacular sunset views in the Mediterranean.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Phaselis: Ancient City in a National Park</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      One of Antalya\'s most magical hidden gems is the ancient city of Phaselis, located within
      the Olympos Beydağları National Park, about 55 kilometers south of Antalya. Founded in the
      7th century BC, Phaselis was an important trading port with three natural harbors. Today,
      the ruins sit amidst pine trees that reach down to three pristine bays, creating a unique
      combination of archaeology and natural beauty. You can swim in the same bays where ancient
      Greek and Roman ships once anchored, with ruins visible beneath the clear water.
    </p>
    <p class="mt-4 text-base leading-relaxed text-neutral-700">
      The site is far less crowded than Perge or Aspendos, and the combination of swimming,
      history, and forest walks makes it a perfect day trip. The adjacent national park also
      contains the Chimaera, an eternal flame that has been burning on Mount Olympos for
      millennia, fueled by natural gas seeping from the rock. We arrange guided day trips to
      Phaselis and the Chimaera, combining ancient history with natural wonder.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Sorgun\'s Serene Shoreline</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      The Sorgun area, just east of Side, is one of the quietest stretches of coastline in the
      Antalya region. Pine forests grow right down to the water\'s edge, and the beaches here are
      notably less crowded than those in Lara or Belek. Resorts like Voyage Sorgun cater to
      adults seeking tranquility rather than action, with serene spa facilities and quiet beach
      areas. The nearby town of Side offers ancient Roman ruins, including the Temple of Apollo
      and a massive Roman theater, all within a 10-minute drive.
    </p>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Hidden Gems Summary</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {gems.map((gem) => (
        <div class="rounded-xl border border-neutral-200 p-5">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg font-semibold text-neutral-900">{gem.name}</h3>
            <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-700">{gem.region}</span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{gem.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-2xl bg-primary-50 p-8 text-center">
      <h3 class="font-display text-2xl font-bold text-neutral-900">Discover Your Hidden Gem</h3>
      <p class="mt-4 text-base text-neutral-600">Our local experts know Antalya\'s secrets. Contact us for personalized recommendations.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <WhatsAppCTA label="Get Personalized Recommendations" message="Hello, I am interested in discovering hidden gems in Antalya. Can you recommend accommodations and experiences?" />
      </div>
    </div>

    <h2 class="mt-16 font-display text-2xl font-bold text-neutral-900">More Articles</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {otherPosts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="group flex items-center gap-4 rounded-xl border border-neutral-200 p-4 transition-all hover:shadow-md">
          <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg">
            <img src={p.image} alt={p.title} class="h-full w-full object-cover" loading="lazy" width="200" height="200" />
          </div>
          <div>
            <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600">{p.title}</h3>
            <p class="text-sm text-neutral-500">{p.readTime}</p>
          </div>
        </a>
      ))}
    </div>
  </article>
</Layout>
