---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import QuickFacts from '../components/QuickFacts.astro';
import { SITE, waLink } from '../data/site';

const heroImage = 'https://images.pexels.com/photos/15564489/pexels-photo-15564489.jpeg?auto=compress&cs=tinysrgb&w=1920';
const boatImage = 'https://images.pexels.com/photos/3851909/pexels-photo-3851909.jpeg?auto=compress&cs=tinysrgb&w=800';
const sailImage = 'https://images.pexels.com/photos/29764490/pexels-photo-29764490.jpeg?auto=compress&cs=tinysrgb&w=800';

const title = 'Antalya Voyage Tour | Yacht Cruises & Coastal Adventures | Tours Antalya';
const description = 'Book Antalya voyage tours: private yacht cruises, boat trips along the Turquoise Coast, swimming in hidden bays, and sunset sailing experiences. Reserve via WhatsApp.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Voyage Tour', item: `${SITE.url}/antalya-voyage-tour/` },
  ],
};

const tourSchema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: 'Antalya Voyage Tour - Yacht Cruises & Coastal Adventures',
  description: 'Private yacht cruises, boat trips, and sailing experiences along the Antalya coastline with swimming, dining, and sunset views.',
  provider: { '@type': 'TravelAgency', name: SITE.name, url: SITE.url },
  touristType: 'Voyage & Yacht Tour',
};

const voyageTypes = [
  { name: 'Private Yacht Charter', duration: 'Full day (8 hours)', priceFrom: '€450', desc: 'Exclusive use of a luxury yacht for up to 12 guests. Includes captain, crew, lunch, and snorkeling gear. Visit hidden bays and swim in crystal-clear waters.' },
  { name: 'Sunset Sailing Cruise', duration: '3 hours', priceFrom: '€65', desc: 'A romantic sunset sail along the Antalya coast with champagne, canapés, and breathtaking views of the cliffs and Old Town bathed in golden light.' },
  { name: 'Group Boat Trip', duration: 'Full day (8 hours)', priceFrom: '€35', desc: 'Join a shared boat tour visiting 3-4 swimming stops including Düden Waterfalls from the sea, ancient Phaselis bays, and pirate caves.' },
  { name: 'Fishing & BBQ Voyage', duration: 'Half day (5 hours)', priceFrom: '€55', desc: 'Fish in the Mediterranean, then enjoy a fresh BBQ on board. Equipment, bait, and grilling included. Perfect for families and groups.' },
];

const itinerary = [
  { time: '09:00', title: 'Boarding at Antalya Marina', desc: 'Meet your captain and crew at the historic Antalya Marina in Kaleiçi. Welcome drinks and safety briefing.' },
  { time: '09:30', title: 'Sail Along the Coastline', desc: 'Cruise past the dramatic cliffs of Antalya, viewing the Old Town from the sea and the cascading Lower Düden Waterfalls.' },
  { time: '11:00', title: 'First Swimming Stop', desc: 'Anchor at a secluded bay with turquoise water for swimming, snorkeling, and paddle boarding.' },
  { time: '12:30', title: 'Onboard Lunch', desc: 'Fresh Mediterranean lunch prepared by the crew: grilled fish, mezes, salads, and Turkish tea.' },
  { time: '14:00', title: 'Second Swimming Stop', desc: 'Visit another pristine bay or the ancient harbor of Phaselis for swimming among ruins.' },
  { time: '16:00', title: 'Return Sail', desc: 'Leisurely sail back to the marina with music, drinks, and the afternoon sun. Disembark at approximately 17:00.' },
];
---

<Layout title={title} description={description} schema={[breadcrumbSchema, tourSchema]} canonical="/antalya-voyage-tour/">
  <section class="relative flex min-h-[50vh] items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt="Boats cruising on blue Mediterranean sea" class="h-full w-full object-cover" fetchpriority="high" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-950/90 via-primary-950/70 to-primary-950/40"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 py-16 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-primary-200 backdrop-blur-sm">
          Voyage & Yacht Tours
        </span>
        <h1 class="mt-6 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
          Antalya Voyage Tour
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-primary-100">
          Sail the Turquoise Coast on a private yacht or join a group boat trip. Swim in hidden
          bays, dine on the water, and experience Antalya\'s stunning coastline from the sea.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppCTA label="Book Your Voyage" message="Hello, I am interested in booking a voyage tour / yacht cruise in Antalya. Please provide options and pricing." />
        </div>
      </div>
    </div>
  </section>

  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Voyage Tour', href: '/antalya-voyage-tour/' },
  ]} />

  <div class="mx-auto max-w-4xl px-4 py-12 lg:px-8">
    <QuickFacts
      title="Key Takeaways"
      items={[
        { label: 'Tour types', value: 'Private yacht, group boat, sunset sail, fishing' },
        { label: 'Duration', value: '3 hours (sunset) to full day (8 hours)' },
        { label: 'Price range', value: 'From €35 (group) to €450+ (private yacht)' },
        { label: 'Capacity', value: 'Up to 12 guests on private charters' },
        { label: 'Includes', value: 'Crew, lunch, swimming stops, snorkeling gear' },
        { label: 'Season', value: 'April to October (best weather and sea conditions)' },
      ]}
    />
  </div>

  <article class="mx-auto max-w-4xl px-4 pb-12 lg:px-8">
    <h2 class="font-display text-3xl font-bold text-neutral-900">
      Discover Antalya from the Sea
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-neutral-700">
      The Antalya coastline is best experienced from the water. Dramatic limestone cliffs plunge
      into the turquoise Mediterranean, hidden caves and bays are accessible only by boat, and the
      ancient cities of Phaselis and Olymos sit directly on the shore. Our <strong>Antalya voyage
      tour</strong> offerings range from romantic sunset sails to full-day private yacht charters,
      each designed to showcase the most beautiful stretches of the Turkish Riviera from a
      perspective that most visitors never see.
    </p>

    <div class="my-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      <div class="overflow-hidden rounded-2xl shadow-lg">
        <img src={boatImage} alt="Sailboats docked at a Turkish marina" class="w-full object-cover" loading="lazy" width="400" height="250" />
      </div>
      <div class="overflow-hidden rounded-2xl shadow-lg">
        <img src={sailImage} alt="Sailboat on calm blue waters" class="w-full object-cover" loading="lazy" width="400" height="250" />
      </div>
    </div>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">
      Voyage Tour Options
    </h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {voyageTypes.map((voyage) => (
        <div class="rounded-2xl border border-neutral-200 p-6">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg font-semibold text-neutral-900">{voyage.name}</h3>
            <span class="rounded-full bg-primary-100 px-3 py-1 text-xs font-bold text-primary-700">From {voyage.priceFrom}</span>
          </div>
          <p class="mt-2 text-xs font-medium text-primary-600">{voyage.duration}</p>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{voyage.desc}</p>
        </div>
      ))}
    </div>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">
      Full-Day Voyage Itinerary
    </h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      Our most popular voyage tour is a full-day cruise departing from Antalya Marina in Kaleiçi.
      Here is a typical itinerary, which can be customized for private charters:
    </p>

    <div class="mt-8 space-y-4">
      {itinerary.map((stop) => (
        <div class="flex gap-6 rounded-2xl border border-neutral-200 p-5">
          <div class="flex-shrink-0">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary-100 text-sm font-bold text-primary-700">
              {stop.time}
            </div>
          </div>
          <div>
            <h3 class="font-display text-lg font-semibold text-neutral-900">{stop.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600">{stop.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">
      What to Bring
    </h2>
    <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {['Swimwear and towel', 'Sunscreen (SPF 30+)', 'Sunglasses and hat', 'Camera or phone', 'Light jacket for evening', 'Sea sickness medication (if needed)'].map((item) => (
        <li class="flex items-start gap-3 rounded-lg bg-neutral-50 px-4 py-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0369a1" stroke-width="2" class="mt-0.5 flex-shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
          <span class="text-sm text-neutral-700">{item}</span>
        </li>
      ))}
    </ul>

    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">
      Private Yacht Charter Highlights
    </h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">
      For the ultimate Antalya voyage experience, a private yacht charter offers exclusivity,
      flexibility, and luxury. Your dedicated captain and crew tailor the route to your
      preferences, whether that means spending extra time at a favorite swimming spot, organizing
      a onboard birthday celebration, or planning a romantic proposal at sunset. Private charters
      include gourmet catering, premium beverages, water sports equipment, and the freedom to
      explore at your own pace. For those seeking cross-destination VIP experiences, we also offer
      access to a <a href="https://www.sevlux.ir/vip-services/luxury-yacht-charter-istanbul/" class="text-primary-600 underline hover:text-primary-700">luxury yacht charter Istanbul</a> service.
    </p>

    <div class="mt-12 rounded-2xl bg-primary-900 p-8 text-center">
      <h3 class="font-display text-2xl font-bold text-white">
        Set Sail on the Turquoise Coast
      </h3>
      <p class="mt-4 text-base text-primary-100">
        Book your Antalya voyage tour via WhatsApp. Private yacht charters, group boat trips, and
        sunset cruises available daily from April to October.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <WhatsAppCTA label="Book Your Voyage Tour" message="Hello, I want to book a voyage tour / yacht cruise in Antalya. Please provide options and pricing." variant="white" />
      </div>
    </div>
  </article>
</Layout>
