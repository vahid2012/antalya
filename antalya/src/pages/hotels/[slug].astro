---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import { SITE, HOTELS, waLink } from '../../data/site';
import { HOTEL_DETAILS } from '../../data/hotelDetails';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return HOTELS.map((hotel) => ({
    params: { slug: hotel.slug },
  }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const hotel = HOTEL_DETAILS[slug!];

if (!hotel) {
  return Astro.redirect('/hotels/');
}

const heroImage = 'https://images.pexels.com/photos/258154/pexels-photo-258154.jpeg?auto=compress&cs=tinysrgb&w=1920';

const title = `${hotel.name} - ${hotel.region} | 5-Star Luxury Hotel in Antalya | Tours Antalya`;
const description = hotel.shortDesc;

const hotelSchema = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: hotel.name,
  starRating: { '@type': 'Rating', ratingValue: String(hotel.starRating) },
  priceRange: hotel.priceRange,
  description: hotel.shortDesc,
  address: {
    '@type': 'PostalAddress',
    addressLocality: hotel.region,
    addressRegion: 'Antalya',
    addressCountry: 'TR',
  },
  amenityFeature: hotel.amenities.slice(0, 10).map((a) => ({
    '@type': 'LocationFeatureSpecification',
    name: a,
    value: true,
  })),
  url: `${SITE.url}/hotels/${hotel.slug}/`,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Hotels', item: `${SITE.url}/hotels/` },
    { '@type': 'ListItem', position: 3, name: hotel.name, item: `${SITE.url}/hotels/${hotel.slug}/` },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hotel.faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const bookMessage = `Hello, I want to book ${hotel.name} in Antalya. Please provide availability and rates.`;
---

<Layout title={title} description={description} schema={[hotelSchema, breadcrumbSchema, faqSchema]} canonical={`/hotels/${hotel.slug}/`}>
  <!-- Hero -->
  <section class="relative flex min-h-[45vh] items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt={`${hotel.name} in ${hotel.region}, Antalya`} class="h-full w-full object-cover" fetchpriority="high" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-950/90 via-primary-950/70 to-primary-950/40"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 py-16 lg:px-8">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3">
          <span class="inline-block rounded-full bg-gold-500 px-3 py-1 text-sm font-bold text-white">
            {hotel.starRating}★ Resort
          </span>
          <span class="inline-block rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-primary-200 backdrop-blur-sm">
            {hotel.region}, Antalya
          </span>
        </div>
        <h1 class="mt-6 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
          {hotel.name}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-primary-100">{hotel.shortDesc}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppCTA label="Book This Hotel Now" message={bookMessage} />
        </div>
      </div>
    </div>
  </section>

  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Hotels', href: '/hotels/' },
    { name: hotel.name, href: `/hotels/${hotel.slug}/` },
  ]} />

  <div class="mx-auto max-w-4xl px-4 py-12 lg:px-8">
    <QuickFacts
      title="Quick Facts"
      items={[
        { label: 'Location', value: `${hotel.region}, Antalya, Turkey` },
        { label: 'Star rating', value: `${hotel.starRating} stars` },
        { label: 'Price range', value: hotel.priceRange },
        { label: 'Booking', value: 'Direct via WhatsApp, no middleman fees' },
        { label: 'Top amenities', value: hotel.highlights.join(', ') },
        { label: 'Best for', value: 'Families, couples, business travelers, golf enthusiasts' },
      ]}
    />
  </div>

  <article class="mx-auto max-w-4xl px-4 pb-12 lg:px-8">
    <!-- Overview -->
    <h2 class="font-display text-3xl font-bold text-neutral-900">About {hotel.name}</h2>
    <p class="mt-6 text-lg leading-relaxed text-neutral-700">{hotel.fullDesc}</p>

    <!-- Location -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Location & Surroundings</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">{hotel.location}</p>

    <!-- Amenities -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Amenities & Facilities</h2>
    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      {hotel.amenities.map((amenity) => (
        <div class="flex items-center gap-3 rounded-lg bg-neutral-50 px-4 py-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0369a1" stroke-width="2" class="flex-shrink-0">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="text-sm text-neutral-700">{amenity}</span>
        </div>
      ))}
    </div>

    <!-- Room Types -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Rooms & Suites</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">{hotel.roomTypes}</p>

    <!-- Dining -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Dining & Restaurants</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">{hotel.dining}</p>

    <!-- Golf & Spa -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Golf & Spa</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">{hotel.golfSpa}</p>

    <!-- Nightlife -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Nightlife & Entertainment</h2>
    <p class="mt-6 text-base leading-relaxed text-neutral-700">{hotel.nightlife}</p>

    <!-- FAQ -->
    <h2 class="mt-12 font-display text-3xl font-bold text-neutral-900">Frequently Asked Questions</h2>
    <div class="mt-6 space-y-4">
      {hotel.faq.map((item) => (
        <details class="group rounded-xl border border-neutral-200 p-5 [&_summary]:cursor-pointer">
          <summary class="flex items-center justify-between text-base font-semibold text-neutral-900">
            {item.question}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-open:rotate-180">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{item.answer}</p>
        </details>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 rounded-2xl bg-primary-50 p-8 text-center">
      <h3 class="font-display text-2xl font-bold text-neutral-900">
        Book {hotel.name} via WhatsApp
      </h3>
      <p class="mt-4 text-base text-neutral-600">
        Contact us for the best available rates, room availability, and special offers at {hotel.name}.
        Our local team responds within minutes.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <WhatsAppCTA label="Check Availability & Rates" message={bookMessage} />
        <a
          href="/hotels/"
          class="inline-flex items-center gap-2 rounded-xl border-2 border-primary-200 px-6 py-3 text-sm font-semibold text-primary-600 transition-all hover:bg-primary-50"
        >
          Browse Other Hotels
        </a>
      </div>
    </div>

    <!-- Other Hotels -->
    <h2 class="mt-16 font-display text-2xl font-bold text-neutral-900">Other Top Hotels in Antalya</h2>
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {HOTELS.filter((h) => h.slug !== hotel.slug).slice(0, 4).map((h) => (
        <a
          href={`/hotels/${h.slug}/`}
          class="group flex items-center gap-4 rounded-xl border border-neutral-200 p-4 transition-all hover:shadow-md"
        >
          <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg">
            <img src="https://images.pexels.com/photos/258154/pexels-photo-258154.jpeg?auto=compress&cs=tinysrgb&w=200" alt={h.name} class="h-full w-full object-cover" loading="lazy" width="200" height="200" />
          </div>
          <div>
            <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600">{h.name}</h3>
            <p class="text-sm text-neutral-500">{h.region}, Antalya</p>
          </div>
        </a>
      ))}
    </div>
  </article>
</Layout>
