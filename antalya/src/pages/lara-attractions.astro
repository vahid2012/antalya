---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import QuickFacts from '../components/QuickFacts.astro';
import { SITE } from '../data/site';

const heroImage = 'https://images.pexels.com/photos/39648346/pexels-photo-39648346.jpeg?auto=compress&cs=tinysrgb&w=1920';
const sunsetImage = 'https://images.pexels.com/photos/31659570/pexels-photo-31659570.jpeg?auto=compress&cs=tinysrgb&w=800';

const title = 'Lara Attractions | Top Things to Do in Lara, Antalya | Tours Antalya';
const description = 'Discover top attractions in Lara, Antalya: Lara Beach, Antalya Aquarium, Aqualand, TerraCity shopping, nightlife clubs, and the historic Lower Düden Waterfalls.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Lara Attractions', item: `${SITE.url}/lara-attractions/` },
  ],
};

const attractions = [
  { name: 'Lara Beach', type: 'Beach', desc: '12 km of golden sand with Blue Flag status, just 10 minutes from Antalya Airport. Warm, shallow water ideal for families. Water sports, sun loungers, and beach clubs available.' },
  { name: 'Lower Düden Waterfalls', type: 'Natural Wonder', desc: 'Where the Düden River plunges 40 meters from a cliff directly into the Mediterranean. Best viewed from the cliffside park or from a boat. Rainbows form in the mist on windy days.' },
  { name: 'Antalya Aquarium', type: 'Family Attraction', desc: 'One of the world\'s largest tunnel aquariums with 131 exhibits, a snow world, and an underwater tunnel. Located in Konyaaltı, 15 minutes from Lara.' },
  { name: 'Aqualand Water Park', type: 'Family Fun', desc: 'Water slides, wave pools, and splash zones for all ages. Located adjacent to the Antalya Aquarium. Perfect for a family day out.' },
  { name: 'TerraCity Shopping Mall', type: 'Shopping', desc: 'Antalya\'s largest shopping mall with international brands, a cinema, food court, and entertainment zone. Located in Lara, walkable from many resorts.' },
  { name: 'Kaleiçi Old Town', type: 'Historic District', desc: 'Antalya\'s historic heart with Roman walls, Ottoman houses, Hadrian\'s Gate, and the Yivli Minaret. Just 15 minutes from Lara by taxi. Bars, restaurants, and boutique shops.' },
  { name: 'Gaga Club & Nightlife', type: 'Nightlife', desc: 'One of Lara\'s biggest nightclubs with multiple dance floors, laser shows, and themed party nights. A short taxi ride from most Lara resorts.' },
  { name: 'Perge Ancient City', type: 'Archaeological Site', desc: 'Extensive Greco-Roman ruins including a colonnaded street, stadium, and Roman baths. 25 minutes from Lara. One of Turkey\'s most significant archaeological sites.' },
];
---

<Layout title={title} description={description} schema={[breadcrumbSchema]} canonical="/lara-attractions/">
  <section class="relative flex min-h-[45vh] items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={heroImage} alt="Antalya coastline with cliffs and ocean" class="h-full w-full object-cover" fetchpriority="high" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-950/90 via-primary-950/70 to-primary-950/40"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 py-16 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-primary-200 backdrop-blur-sm">
          Lara Attractions
        </span>
        <h1 class="mt-6 font-display text-4xl font-bold leading-tight text-white sm:text-5xl">
          Top Things to Do in Lara
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-primary-100">
          From 12 kilometers of golden sand to the spectacular Düden Waterfalls, ancient ruins,
          world-class shopping, and vibrant nightlife, Lara offers something for every traveler.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <WhatsAppCTA label="Book a Lara Tour" message="Hello, I want to book attractions and activities in Lara, Antalya. Please provide options and pricing." />
        </div>
      </div>
    </div>
  </section>

  <Breadcrumb items={[
    { name: 'Home', href: '/' },
    { name: 'Lara Attractions', href: '/lara-attractions/' },
  ]} />

  <div class="mx-auto max-w-4xl px-4 py-12 lg:px-8">
    <QuickFacts
      title="Quick Facts"
      items={[
        { label: 'Top attraction', value: 'Lara Beach (12 km golden sand)' },
        { label: 'Natural wonder', value: 'Lower Düden Waterfalls into the sea' },
        { label: 'Family fun', value: 'Antalya Aquarium & Aqualand water park' },
        { label: 'Shopping', value: 'TerraCity Mall (largest in Antalya)' },
        { label: 'Nightlife', value: 'Gaga Club and Lara beach clubs' },
        { label: 'Distance to city', value: '15 min to Kaleiçi Old Town' },
      ]}
    />
  </div>

  <article class="mx-auto max-w-4xl px-4 pb-8 lg:px-8">
    <h2 class="font-display text-3xl font-bold text-neutral-900">
      Lara: Beach, Fun, and Convenience
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-neutral-700">
      Lara is Antalya\'s most accessible resort area, located just 8-12 kilometers from Antalya
      Airport. Its 12-kilometer stretch of golden sand is one of the finest beaches on the
      Turkish Riviera, backed by a line of five-star all-inclusive resorts. But Lara is much more
      than a beach destination. The area is a hub for family entertainment, shopping, and
      nightlife, with attractions ranging from the spectacular Düden Waterfalls to the Antalya
      Aquarium and TerraCity shopping mall.
    </p>
    <p class="mt-4 text-base leading-relaxed text-neutral-700">
      Its proximity to Antalya city center (just 15 minutes) makes Lara an ideal base for
      exploring the historic Kaleiçi Old Town, the ancient city of Perge, and the broader
      Antalya region. A <strong>Lara all-inclusive resort with nightclub access</strong> gives
      you beach luxury by day and entertainment by night, all within easy reach of the airport
      and city attractions.
    </p>
    <div class="my-8 overflow-hidden rounded-2xl shadow-lg">
      <img src={sunsetImage} alt="Sunrise over Antalya beach" class="w-full object-cover" loading="lazy" width="800" height="400" />
    </div>
  </article>

  <section class="mx-auto max-w-7xl px-4 pb-12 lg:px-8">
    <h2 class="font-display text-3xl font-bold text-neutral-900">Top Attractions in Lara</h2>
    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {attractions.map((attr) => (
        <div class="rounded-2xl border border-neutral-200 p-6 transition-shadow hover:shadow-lg">
          <span class="rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-700">{attr.type}</span>
          <h3 class="mt-3 font-display text-lg font-bold text-neutral-900">{attr.name}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{attr.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
      <a href="/lara-hotels/" class="group rounded-2xl border border-primary-200 bg-primary-50 p-6 text-center transition-all hover:shadow-lg">
        <h3 class="font-display text-lg font-bold text-primary-700">Book a Hotel in Lara</h3>
        <p class="mt-2 text-sm text-neutral-600">5-star beachfront all-inclusive resorts</p>
      </a>
      <a href="/antalya-nightlife-disco/" class="group rounded-2xl border border-neutral-200 p-6 text-center transition-all hover:shadow-lg">
        <h3 class="font-display text-lg font-bold text-neutral-900 group-hover:text-primary-600">Lara Nightlife & VIP Tables</h3>
        <p class="mt-2 text-sm text-neutral-500">Gaga Club, beach clubs, bar crawls</p>
      </a>
    </div>

    <div class="mt-12 rounded-2xl bg-primary-50 p-8 text-center">
      <h3 class="font-display text-2xl font-bold text-neutral-900">Explore Lara with Us</h3>
      <p class="mt-4 text-base text-neutral-600">Book tours, aquarium tickets, water parks, and VIP nightlife via WhatsApp.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <WhatsAppCTA label="Book Lara Activities" message="Hello, I want to book attractions and activities in Lara, Antalya. Please provide options." />
      </div>
    </div>
  </section>
</Layout>
